{
  "$description": "Prescriptive design tokens — a technology-agnostic, monochrome baseline in the W3C Design Tokens (DTCG) format. Projects consume these directly or map them onto their own theme (see website/ for a Tailwind mapping). Aliases use the {group.token} reference syntax.",
  "color": {
    "$type": "color",
    "neutral": {
      "$description": "The single, subtly warm grayscale ramp. Hierarchy comes from value, not hue — the faint warmth just keeps large light/dark fields from reading clinical.",
      "0": { "$value": "#ffffff" },
      "50": { "$value": "#fafaf8" },
      "100": { "$value": "#f4f3f0" },
      "200": { "$value": "#e8e6e0" },
      "300": { "$value": "#d6d3cb" },
      "400": { "$value": "#a8a49b" },
      "500": { "$value": "#78746c" },
      "600": { "$value": "#57534c" },
      "700": { "$value": "#413e38" },
      "800": { "$value": "#292623" },
      "900": { "$value": "#1b1917" },
      "950": { "$value": "#110f0d" },
      "1000": { "$value": "#000000" }
    },
    "ink": { "$value": "{color.neutral.900}", "$description": "Primary foreground/text." },
    "paper": { "$value": "{color.neutral.50}", "$description": "Page background." },
    "surface": { "$value": "{color.neutral.0}", "$description": "Raised surfaces (cards, menus)." },
    "muted": { "$value": "{color.neutral.500}", "$description": "Secondary/subdued text." },
    "border": { "$value": "{color.neutral.200}", "$description": "Hairline borders and dividers." },
    "accent": { "$value": "{color.neutral.900}", "$description": "Primary action / emphasis fill." },
    "accentContrast": { "$value": "{color.neutral.0}", "$description": "Foreground on the accent fill." },
    "action": {
      "$description": "Semantic role for interactive controls. Monochrome baseline; retheme to a brand hue.",
      "default": { "$value": "{color.neutral.900}", "$description": "Resting interactive fill." },
      "hover": { "$value": "{color.neutral.700}", "$description": "Hovered interactive fill." },
      "subtle": { "$value": "{color.neutral.100}", "$description": "Low-emphasis interactive surface." },
      "onAction": { "$value": "{color.neutral.0}", "$description": "Foreground on an action fill." }
    },
    "status": {
      "$description": "Feedback roles. Semantic hues even in the monochrome baseline, so severity is never conveyed by fill weight alone; retheme freely. Each one is dark enough to pass AA as text on `paper` and `surface`, since these are used as often for labels and icons as for fills.",
      "info": { "$value": "#0073d3" },
      "success": { "$value": "#00844d" },
      "warning": { "$value": "#9f6700" },
      "danger": { "$value": "#d73434" }
    },
    "chart": {
      "$description": "Categorical series colors. Monochrome baseline steps the neutral ramp.",
      "1": { "$value": "{color.neutral.900}" },
      "2": { "$value": "{color.neutral.700}" },
      "3": { "$value": "{color.neutral.500}" },
      "4": { "$value": "{color.neutral.400}" },
      "5": { "$value": "{color.neutral.300}" },
      "6": { "$value": "{color.neutral.200}" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica", "Arial", "sans-serif"]
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "Liberation Mono", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "normal": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "base": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" }
    },
    "lineHeight": {
      "$type": "number",
      "tight": { "$value": 1.2 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.65 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Spacing scale for padding, margin, and gaps.",
    "0": { "$value": "0rem" },
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" },
    "inline": {
      "$description": "Semantic horizontal padding for controls (button, input, badge).",
      "sm": { "$value": "{space.2}" },
      "md": { "$value": "{space.3}" },
      "lg": { "$value": "{space.4}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0rem" },
    "sm": { "$value": "0.375rem" },
    "md": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" },
    "xl": { "$value": "1rem" },
    "2xl": { "$value": "1.25rem" },
    "3xl": { "$value": "1.75rem" },
    "full": { "$value": "9999px" }
  },
  "borderWidth": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "thick": { "$value": "2px" }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": { "color": "rgba(28,25,23,0.05)", "offsetX": "0rem", "offsetY": "1px", "blur": "3px", "spread": "0rem" }
    },
    "md": {
      "$value": { "color": "rgba(28,25,23,0.07)", "offsetX": "0rem", "offsetY": "6px", "blur": "18px", "spread": "-6px" }
    },
    "lg": {
      "$value": { "color": "rgba(28,25,23,0.10)", "offsetX": "0rem", "offsetY": "18px", "blur": "40px", "spread": "-12px" }
    }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "200ms" },
    "slow": { "$value": "320ms" }
  },
  "zIndex": {
    "$type": "number",
    "base": { "$value": 0 },
    "dropdown": { "$value": 1000 },
    "overlay": { "$value": 1100 },
    "modal": { "$value": 1200 },
    "toast": { "$value": 1300 }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Minimum viewport widths at which a layout may adapt. Spec API contracts reference these ids (sm, md, lg…) in their `responsive.reflow[].at`, so 'small screen' has a shared, concrete meaning. Aligned with common utility-framework defaults.",
    "sm": { "$value": "40rem", "$description": "≥ 640px — large phone / small tablet." },
    "md": { "$value": "48rem", "$description": "≥ 768px — tablet." },
    "lg": { "$value": "64rem", "$description": "≥ 1024px — small laptop." },
    "xl": { "$value": "80rem", "$description": "≥ 1280px — desktop." },
    "2xl": { "$value": "96rem", "$description": "≥ 1536px — large desktop." }
  }
}
