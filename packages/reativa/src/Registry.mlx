      el ~cls:"space-y-4 rounded-lg border border-neutral-200 bg-surface p-5" "div"
        [
          el ~cls:"text-sm font-semibold text-neutral-900" "h3" [ txt "Payment details" ];
          Field.make ~label:"Card number" ~for_:"co-card"
            ~children:[ Input.make ~id:"co-card" ~placeholder:"4242 4242 4242 4242" () ] ();
          el ~cls:"grid grid-cols-2 gap-3" "div"
            [
              Field.make ~label:"Expiry" ~for_:"co-exp"
                ~children:[ Input.make ~id:"co-exp" ~placeholder:"MM/YY" () ] ();
              Field.make ~label:"CVC" ~for_:"co-cvc"
                ~children:[ Input.make ~id:"co-cvc" ~placeholder:"123" () ] ();
            ];
          Button.make ~variant:`primary ~extra_class:"w-full"
            ~children:[ txt "Pay $144.00" ] ();
        ];
      el ~cls:"space-y-3 rounded-lg border border-neutral-200 bg-neutral-50 p-5" "div"
        [
          el ~cls:"text-sm font-semibold text-neutral-900" "h3" [ txt "Order summary" ];
          el ~cls:"space-y-2 text-sm" "ul"
            (List.map
               (fun (name, price) ->
                 el ~cls:"flex justify-between text-neutral-700" "li"
                   [ txt name; el ~cls:"tabular-nums" "span" [ txt price ] ])
               items);
          Separator.make ();
          el ~cls:"flex justify-between text-sm font-semibold text-neutral-900" "div"
            [ txt "Total"; el ~cls:"tabular-nums" "span" [ txt "$144.00" ] ];
        ];
    ]

