let dashboard_example () =
  let stat label value delta =
    el ~cls:(Ui.card ^ " p-4") "div"
      [
        el ~cls:"text-xs text-neutral-500" "p" [ txt label ];
        el ~cls:"mt-1 text-2xl font-bold text-neutral-900" "p" [ txt value ];
        el ~cls:"mt-1 text-xs text-neutral-400" "p" [ txt delta ];
      ]
  in
  let bars = [ 50; 72; 40; 88; 63; 45; 70 ] in
  el ~cls:"w-full max-w-2xl space-y-4" "div"
    [
